#. odoo-javascript
#: code:addons/pos_icon_picker/static/src/js/pos_icon_picker_action.js:0
msgid "Could not load icon styles."
msgstr "No se pudieron cargar los estilos de iconos."

#. module: pos_icon_picker
#. odoo-javascript
#: code:addons/pos_icon_picker/static/src/js/pos_icon_picker_action.js:0
msgid "Select an icon before applying."
msgstr "Selecciona un icono antes de aplicar."

#. module: pos_icon_picker
#. odoo-javascript
#: code:addons/pos_icon_picker/static/src/js/pos_icon_picker_action.js:0
