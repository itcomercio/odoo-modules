#. module: pos_icon_picker
#: model:ir.module.module,shortdesc:pos_icon_picker.module_pos_icon_picker
msgid "Comodoo POS Icon Picker"
msgstr "Comodoo Selector de Iconos TPV"

#. module: pos_icon_picker
#: model:ir.module.module,summary:pos_icon_picker.module_pos_icon_picker
msgid "Pick POS product icons from bundled style libraries"
msgstr "Selecciona iconos para productos TPV desde librerías de estilos incluidas"

#. module: pos_icon_picker
#. odoo-python
#: code:addons/pos_icon_picker/models/product_template.py:0
msgid "You do not have permission to use the POS icon picker."
msgstr "No tienes permisos para usar el selector de iconos TPV."

#. module: pos_icon_picker
#. odoo-python
#: code:addons/pos_icon_picker/models/product_template.py:0
msgid "You do not have permission to update POS icons."
msgstr "No tienes permisos para actualizar iconos TPV."

#. module: pos_icon_picker
#. odoo-python
#: code:addons/pos_icon_picker/models/product_template.py:0
msgid "A product is required."
msgstr "Se requiere un producto."

#. module: pos_icon_picker
#. odoo-python
#: code:addons/pos_icon_picker/models/product_template.py:0
msgid "Please select an icon style and icon file."
msgstr "Selecciona un estilo de icono y un fichero de icono."

#. module: pos_icon_picker
#. odoo-python
#: code:addons/pos_icon_picker/models/product_template.py:0
msgid "Invalid style or file name."
msgstr "Nombre de estilo o fichero no válido."

#. module: pos_icon_picker
#. odoo-python
#: code:addons/pos_icon_picker/models/product_template.py:0
msgid "Product not found."
msgstr "Producto no encontrado."

#. module: pos_icon_picker
#. odoo-python
#: code:addons/pos_icon_picker/models/product_template.py:0
msgid "Icon file not found: %s"
msgstr "Fichero de icono no encontrado: %s"

