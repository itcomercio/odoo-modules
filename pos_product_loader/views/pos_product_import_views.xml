<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_product_import_log_list" model="ir.ui.view">
        <field name="name">pos.product.import.log.list</field>
        <field name="model">pos.product.import.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="status"/>
                <field name="import_path"/>
                <field name="imported_count"/>
                <field name="updated_count"/>
                <field name="skipped_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <record id="view_pos_product_import_log_form" model="ir.ui.view">
        <field name="name">pos.product.import.log.form</field>
        <field name="model">pos.product.import.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,done,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="import_path" readonly="1"/>
                    </group>
                    <group>
                        <field name="imported_count" readonly="1"/>
                        <field name="updated_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="notes" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_product_import_wizard_form" model="ir.ui.view">
        <field name="name">pos.product.import.wizard.form</field>
        <field name="model">pos.product.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar productos POS">
                <div class="alert alert-info" role="alert">
                    <p>Se iniciara la importacion desde la ruta configurada en Ajustes de Punto de Venta.</p>
                </div>
                <footer>
                    <button name="action_run_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_product_import_log" model="ir.actions.act_window">
        <field name="name">Import Logs</field>
        <field name="res_model">pos.product.import.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ejecuta una importacion para ver logs.
            </p>
        </field>
    </record>

    <record id="action_open_pos_product_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar productos POS</field>
        <field name="res_model">pos.product.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pos_product_loader_root"
              name="Product Loader"
              parent="point_of_sale.menu_point_root"
              sequence="80"/>

    <menuitem id="menu_pos_product_import_logs"
              name="Import Logs"
              parent="menu_pos_product_loader_root"
              action="action_pos_product_import_log"
              sequence="10"/>

    <menuitem id="menu_pos_product_import_now"
              name="Importar ahora"
              parent="menu_pos_product_loader_root"
              action="action_open_pos_product_import_wizard"
              sequence="20"/>
</odoo>

